# Copy to .env.local and fill all values

# Supabase (cloud project, or local stack: `supabase start`, then see README "Supabase locally";
# local values: SUPABASE_URL=http://127.0.0.1:55321, DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55322/postgres,
# keys from `supabase status -o env`)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NEVER expose to browser
SUPABASE_JWT_SECRET=your-supabase-jwt-secret   # legacy HS256 projects only; ES256/RS256 tokens are verified via SUPABASE_URL/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# MongoDB Atlas
MONGO_URI=mongodb+srv://dephgraph:[password]@cluster0.xxxxx.mongodb.net/dephgraph?retryWrites=true&w=majority
MONGO_DB_NAME=dephgraph

# Redis (Upstash rediss:// or local redis://)
REDIS_URL=rediss://default:[token]@xxxx.upstash.io:6380

# GitHub
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_BASE64=LS0t...   # base64-encoded PEM private key
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret

# Groq (free tier, Stage 3)
GROQ_API_KEY=gsk_xxx...

# App
ENVIRONMENT=development
SECRET_KEY=your-32-char-random-key
INTERNAL_CRON_SECRET=another-random-secret   # guards /internal/* endpoints

# Frontend (safe to expose)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Web dashboard (apps/web)
AUTH_DISABLED=false   # "true" only for local dev without Supabase; fails closed otherwise
DEV_API_TOKEN=   # server-only; dev JWT from scripts/make_dev_token.py, used when AUTH_DISABLED=true
API_URL=http://localhost:8000   # server-side API base (falls back to NEXT_PUBLIC_API_URL)

# API tuning (optional; defaults shown)
GROQ_MODEL=llama-3.1-70b-versatile
CORS_ORIGINS=["http://localhost:3000"]   # JSON list of allowed browser origins
RATE_LIMIT=100/minute   # per client IP, all routes except /health
TRUSTED_PROXY_HOPS=1   # proxies in front of the API (Render=1); 0 = ignore X-Forwarded-For
